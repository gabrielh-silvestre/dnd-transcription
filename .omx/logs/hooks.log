   31\t\n    32\t  public async segment(input: SegmentMediaInput): Promise<SegmentMediaResult> {\n    33\t    const resolvedInputPath = resolve(input.inputPath);\n    34\t    const probe = await probeMedia({\n    35\t      inputPath: resolvedInputPath,\n    36\t      ffprobePath: this.ffprobePath,\n    37\t      env: this.env,\n    38\t    });\n    39\t    const totalDurationMs = probe.durationMs;\n    40\t    const chunkCount = Math.max(1, Math.ceil(totalDurationMs / input.chunkDurationMs));\n    41\t    const manifestChunks: ChunkManifestEntry[] = [];\n    42\t\n    43\t    await mkdir(input.workingDir, { recursive: true });\n    44\t\n    45\t    for (let index = 1; index <= chunkCount; index += 1) {\n    46\t      const startMs = (index - 1) * input.chunkDurationMs;\n    47\t      const endMs = Math.min(totalDurationMs, index * input.chunkDurationMs);\n    48\t      const outputPath = join(input.workingDir, formatChunkAudioFileName(index));\n    49\t\n    50\t      await runCommand(\n    51\t        [\n    52\t          this.ffmpegPath,\n    53\t          \"-hide_banner\",\n    54\t          \"-loglevel\",\n    55\t          \"error\",\n    56\t          \"-y\",\n    57\t          \"-ss\",\n    58\t          toSeconds(startMs),\n    59\t          \"-i\",\n    60\t          resolvedInputPath,\n    61\t          \"-t\",\n    62\t          toSeconds(endMs - startMs),\n    63\t          \"-vn\",\n    64\t          \"-ac\",\n    65\t          \"1\",\n    66\t          \"-ar\",\n    67\t          \"16000\",\n    68\t          \"-sample_fmt\",\n    69\t          \"s16\",\n    70\t          outputPath,\n    71\t        ],\n    72\t        {\n    73\t          env: this.env,\n    74\t        },\n    75\t      );\n    76\t\n    77\t      manifestChunks.push({\n    78\t        index,\n    79\t        startMs,\n    80\t        endMs,\n    81\t        chunkPath: normalizeRelativePath(input.jobRootDir, outputPath),\n    82\t      });\n    83\t    }\n    84\t\n    85\t    retu