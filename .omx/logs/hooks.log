t(input.chunkIndex) ?? 0);\n    27\t\n    28\t    return {\n    29\t      chunkIndex: input.chunkIndex,\n    30\t      markdown: `Texto do chunk ${input.chunkIndex}`,\n    31\t    };\n    32\t  }\n    33\t}\n    34\t\n    35\tclass ControlledTranscriber implements Transcriber {\n    36\t  public readonly name = \"controlled\";\n    37\t  private readonly failuresRemaining: Map<number, number>;\n    38\t\n    39\t  public constructor(failuresRemaining: Record<number, number>) {\n    40\t    this.failuresRemaining = new Map(Object.entries(failuresRemaining).map(([key, value]) => [Number(key), value]));\n    41\t  }\n    42\t\n    43\t  public async transcribe(input: TranscriptionRequest): Promise<TranscriptionResult> {\n    44\t    const remaining = this.failuresRemaining.get(input.chunkIndex) ?? 0;\n    45\t\n    46\t    if (remaining > 0) {\n    47\t      this.failuresRemaining.set(input.chunkIndex, remaining - 1);\n    48\t      throw new Error(`falha planejada para chunk ${input.chunkIndex}`);\n    49\t    }\n    50\t\n    51\t    return {\n    52\t      chunkIndex: input.chunkIndex,\n    53\t      markdown: `Markdown do chunk ${input.chunkIndex}`,\n    54\t    };\n    55\t  }\n    56\t}\n    57\t\n    58\tfunction createSegmenter(): StubMediaSegmenter {\n    59\t  return new StubMediaSegmenter({\n    60\t    totalDurationMs: 180_000,\n    61\t    chunks: [\n    62\t      { index: 1, startMs: 0, endMs: 60_000 },\n    63\t      { index: 2, startMs: 60_000, endMs: 120_000 },\n    64\t      { index: 3, startMs: 120_000, endMs: 180_000 },\n    65\t    ],\n    66\t  });\n    67\t}\n    68\t\n    69\tasync function createInputFixture(root: string): Promise<string> {\n    70\t  const inputPath = join(root, \"input.mkv\");\n    71\t  await writeFile(inputPath, \"fixture\", \"utf8\");\n    72\t  return inputPath;\n    73\t}\n    74\t\n    75\ttest(\"CLI gera N markdowns parciais e consolidado final em ordem do manifesto\", async (context) => {\n    76\t  const root = await createTempDir(\"cli-e2e\", context);\n    77\t  const outputDir = join(root, \"job\");\n    78\t  const inputPath = await createInputFixture(root);\n    79\t  const exitCode = await runCli(\n    80\t    [\n    81\t      \"--input\",\n    82\t      inputPath,\n    83\t      \"--output\",\n    84\t      outputDir,\n    85\t      \"--chunk-duration-seconds\",\n    86\t      \"60\",\n    87\t      \"--concurrency\",\n    88\t      \"3\",\n    89\t      \"--provider\",\n    90\t      \"fake\",\n    91\t      \"--cleanup-policy\",\n    92\t      \"keep\",\n    93\t    ],\n    94\t    {\n    95\t      createJobStore: (dir) => new FileJobStore(resolveJobPaths(dir)),\n    96\t      createMediaSegmenter: () => createSegmenter(),\n    97\t      createTranscriber: () => new OrderedTranscriber(),\n    98\t    },\n    99\t  );\n   100\t\n   101\t  assert.equal(exitCode, 0);\n   102\t\n   103\t  const finalMarkdown = await readFile(join(outputDir, \"transcript.md\"), \"utf8\");\n   104\t  assert.match(finalMarkdown, /# Chunk 0001[\\s\\S]*# Chunk 0002[\\s\\S]*# Chunk 0003/);\n   105\t\n   106\t  await stat(join(outputDir, \"transcripts/0001.md\"));\n   107\t  await stat(join(outputDir, \"transcripts/0002.md\"));\n   108\t  await stat(join(outputDir, \"transcripts/0003.md\"));\n   109\t});\n   110\t\n   111\ttest(\"falha parcial retorna exit code 2 e --resume reexecuta apenas o chunk falho\", async (context) => {\n   112\t  const root = await createTempDir(\"resume-partial\", context);\n   113\t  const outputDir = join(root, \"job\");\n   114\t  const inputPath = await createInputFixture(root);\n   115\t  const jobStore = new FileJobStore(resolveJobPaths(outputDir));\n   116\t  const logger = createLogger();\n   117\t\n   118\t  const firstRun = await runTranscriptionJob({\n   119\t    inputPath,\n   120\t    outputDir,\n   121\t    chunkDurationSeconds: 60,\n   122\t    chunkDurationMs: 60_000,\n   123\t    concurrency: 2,\n   124\t    provider: \"fake\",\n   125\t    cleanupPolicy: \"keep\",\n   126\t    resume: false,\n   127\t    jobStore,\n   128\t    mediaSegmenter: createSegmenter(),\n   129\t    transcriber: new ControlledTranscriber({ 2: 1 }),\n   130\t    logger,\n   131\t  });\n   132\t\n   133\t  assert.equal(firstRun.exitCode, 2);\n   134\t  assert.equal(firstRun.jobStatus, \"partial_failed\");\n   135\t\n   136\t  const failedStateBeforeResume = JSON.parse(await readFile(join(outputDir, \"job-state.json\"), \"utf8\")) as {\n   137\t    status: string;\n   138\t    chunks: Array<{ index: number; attempts: number; status: string }>;\n   139\t  };\n   140\t\n   141\t  assert.equal(failedStateBeforeResume.status, \"partial_failed\");\n   142\t  assert.equal(failedStateBeforeResume.chunks.find((chunk) => chunk.index === 1)?.attempts, 1);\n   143\t  assert.equal(failedStateBeforeResume.chunks.find((chunk) => chunk.index === 2)?.attempts, 1);\n   144\t  assert.equal(failedStateBeforeResume.chunks.find((chunk) => chunk.index === 3)?.attempts, 1);\n   145\t\n   146\t  const resumedRun = await runTranscriptionJob({\n   147\t    inputPath,\n   148\t    outputDir,\n   149\t    chunkDurationSeconds: 60,\n   150\t    chunkDurationMs: 60_000,\n   151\t    concurrency: 2,\n   152\t    provider: \"fake\",\n   153\t    cleanupPolicy: \"keep\",\n   154\t    resume: true,\n   155\t    jobStore,\n   156\t    mediaSegmenter: createSegmenter(),\n   157\t    transcriber: new ControlledTranscriber({}),\n   158\t    logger,\n   159\t  });\n   160\t\n   161\t  assert.equal(resumedRun.exitCode, 0);\n   162\t\n   163\t  const stateAfterResume = JSON.parse(await readFile(join(outputDir, \"job-state.json\"), \"utf8\")) as {\n   164\t    status: string;\n   165\t    chunks: Array<{ index: number; attempts: number }>;\n   166\t  };\n   167\t\n   168\t  assert.equal(stateAfterResume.status, \"succeeded\");\n   169\t  assert.equal(stateAfterResume.chunks.find((chunk) => chunk.index === 1)?.attempts, 1);\n   170\t  assert.equal(stateAfterResume.chunks.find((chunk) => chunk.index === 2)?.attempts, 2);\n   171\t  assert.equal(stateAfterResume.chunks.find((chunk) => chunk.index === 3)?.attempts, 1);\n   172\t});\n   173\t\n   174\ttest(\"sem --resume o outputDir ocupado falha antes de reaproveitar artefatos\", async (context) => {\n   175\t  const root = await createTempDir(\"no-resume\", context);\n   176\t  const outputDir = join(root, \"job\");\n   177\t  const inputPath = await createInputFixture(root);\n   178\t  const logger = createLogger();\n   179\t  const jobStore = new FileJobStore(resolveJobPaths(outputDir));\n   180\t\n   181\t  await runTranscriptionJob({\n   182\t    inputPath,\n   183\t    outputDir,\n   184\t    chunkDurationSeconds: 60,\n   185\t    chunkDurationMs: 60_000,\n   186\t    concurrency: 2,\n   187\t    provider: \"fake\",\n   188\t    cleanupPolicy: \"keep\",\n   189\t    resume: false,\n   190\t    jobStore,\n   191\t    mediaSegmenter: createSegmenter(),\n   192\t    transcriber: new ControlledTranscriber({ 2: 1 }),\n   193\t    logger,\n   194\t  });\n   195\t\n   196\t  const stateBefore = await readFile(join(outputDir, \"job-state.json\"), \"utf8\");\n   197\t  const secondRun = await runTranscriptionJob({\n   198\t    inputPath,\n   199\t    outputDir,\n   200\t    chunkDurationSeconds: 60,\n   201\t    chunkDurationMs: 60_000,\n   202\t    concurrency: 2,\n   203\t    provider: \"fake\",\n   204\t    cleanupPolicy: \"keep\",\n   205\t    resume: false,\n   206\t    jobStore,\n   207\t    mediaSegmenter: createSegmenter(),\n   208\t    transcriber: new ControlledTranscriber({}),\n   209\t    logger,\n   210\t  });\n   211\t  const stateAfter = await readFile(join(outputDir, \"job-state.json\"), \"utf8\");\n   212\t\n   213\t  assert.equal(secondRun.exitCode, 1);\n   214\t  assert.equal(stateBefore, stateAfter);\n   215\t});\n   216\t\n   217\ttest(\"resume rejeita snapshot incompativel e recupera chunk running orfao\", async (context) => {\n   218\t  const root = await createTempDir(\"resume-snapshot\", context);\n   219\t  const outputDir = join(root, \"job\");\n   220\t  const inputPath = await createInputFixture(root);\n   221\t  const logger = createLogger();\n   222\t  const jobStore = new FileJobStore(resolveJobPaths(outputDir));\n   223\t\n   224\t  await runTranscriptionJob({\n   225\t    inputPath,\n   226\t    outputDir,\n   227\t    chunkDurationSeconds: 60,\n   228\t    chunkDurationMs: 60_000,\n   229\t    concurrency: 2,\n   230\t    provider: \"fake\",\n   231\t    cleanupPolicy: \"keep\",\n   232\t    resume: false,\n   233\t    jobStore,\n   234\t    mediaSegmenter: createSegmenter(),\n   235\t    transcriber: new ControlledTranscriber({}),\n   236\t    logger,\n   237\t  });\n   238\t\n   239\t  const mismatch = await runTranscriptionJob({\n   240\t    inputPath,\n   241\t    outputDir,\n   242\t    chunkDurationSeconds: 120,\n   243\t    chunkDurationMs: 120_000,\n   244\t    concurrency: 2,\n   245\t    provider: \"fake\",\n   246\t    cleanupPolicy: \"keep\",\n   247\t    resume: true,\n   248\t    jobStore,\n   249\t    mediaSegmenter: createSegmenter(),\n   250\t    transcriber: new ControlledTranscriber({}),\n   251\t    logger,\n   252\t  });\n   253\t\n   254\t  assert.equal(mismatch.exitCode, 1);\n   255\t\n   256\t  const orphanRoot = await createTempDir(\"resume-orphan\", context);\n   257\t  const orphanOutputDir = join(orphanRoot, \"job\");\n   258\t  const orphanInputPath = await createInputFixture(orphanRoot);\n   259\t  const orphanStore = new FileJobStore(resolveJobPaths(orphanOutputDir));\n   260\t\n   261\t  await orphanStore.initializeJob({\n   262\t    jobId: \"job-orphan\",\n   263\t    provider: \"fake\",\n   264\t    cleanupPolicy: \"keep\",\n   265\t    compatibility: {\n   266\t      resolvedInputPath: orphanInputPath,\n   267\t      inputSizeBytes: 7,\n   268\t      inputMtimeMs: (await stat(orphanInputPath)).mtimeMs,\n   269\t      provider: \"fake\",\n   270\t      chunkDurationSeconds: 60,\n   271\t    },\n   272\t  });\n   273\t\n   274\t  const segmenter = createSegmenter();\n   275\t  const segmentation = await segmenter.segment({\n   276\t    inputPath: orphanInputPath,\n   277\t    jobRootDir: orphanStore.paths.rootDir,\n   278\t    workingDir: orphanStore.paths.chunksDir,\n   279\t    chunkDurationMs: 60_000,\n   280\t  });\n   281\t\n   282\t  await orphanStore.updateJobStatus(\"segmenting\");\n   283\t  await orphanStore.writeManifest(segmentation.manifest);\n   284\t  await orphanStore.hydrateChunksFromManifest(segmentation.manifest);\n   285\t  await orphanStore.updateJobStatus(\"ready\");\n   286\t  await orphanStore.updateJobStatus(\"running\");\n   287\t  const markdownPath = await orphanStore.writeChunkMarkdown(1, \"# Chunk 0001\\n\\nok\\n\");\n   288\t  await orphanStore.markChunkRunning(1);\n   289\t  await orphanStore.markChunkSucceeded(1, markdownPath);\n   290\t  await orphanStore.markChunkRunning(2);\n   291\t\n   292\t  const resumed = await runTranscriptionJob({\n   293\t    inputPath: orphanInputPath,\n   294\t    outputDir: orphanOutputDir,\n   295\t    chunkDurationSeconds: 60,\n   296\t    chunkDurationMs: 60_000,\n   297\t    concurrency: 2,\n   298\t    provider: \"fake\",\n   299\t    cleanupPolicy: \"keep\",\n   300\t    resume: true,\n   301\t    jobStore: orphanStore,\n   302\t    mediaSegmenter: createSegmenter(),\n   303\t    transcriber: new ControlledTranscriber({}),\n   304\t    logger,\n   305\t  });\n   306\t\n   307\t  assert.equal(resumed.exitCode, 0);\n   308\t\n   309\t  const orphanState = JSON.parse(await readFile(join(orphanOutputDir, \"job-state.json\"), \"utf8\")) as {\n   310\t    chunks: Array<{ index: number; attempts: number; status: string }>;\n   311\t  };\n   312\t\n   313\t  assert.equal(orphanState.chunks.find((chunk) => chunk.index === 2)?.attempts, 2);\n   314\t  assert.equal(orphanState.chunks.find((chunk) => chunk.index === 2)?.status, \"succeeded\");\n   315\t});\n","tool_use_id":"call_qffzztz1zMY3y5FHtaZCSdTP"}
