0\texport async function runCli(argv: string[], dependencies: CliDependencies = {}): Promise<number> {\n    31\t  const logger = dependencies.createLogger?.() ?? createLogger();\n    32\t\n    33\t  try {\n    34\t    const parsed = parseArgs(argv);\n    35\t\n    36\t    if (parsed.kind === \"help\") {\n    37\t      process.stdout.write(parsed.text);\n    38\t      return 0;\n    39\t    }\n    40\t\n    41\t    const { options } = parsed;\n    42\t    const jobStore = dependencies.createJobStore?.(options.outputDir)\n    43\t      ?? new FileJobStore(resolveJobPaths(options.outputDir));\n    44\t    const mediaSegmenter = dependencies.createMediaSegmenter?.()\n    45\t      ?? new FFmpegMediaSegmenter();\n    46\t    const transcriber = dependencies.createTranscriber?.(options.provider)\n    47\t      ?? createDefaultTranscriber(options.provider);\n    48\t    const result = await runTranscriptionJob({\n    49\t      ...options,\n    50\t      jobStore,\n    51\t      mediaSegmenter,\n    52\t      transcriber,\n    53\t      logger,\n    54\t    });\n    55\t\n    56\t    if (result.exitCode === 0) {\n    57\t      logger.info(\"job\", \"Pipeline concluido com sucesso.\", {\n    58\t        finalMarkdownPath: result.finalMarkdownPath,\n    59\t      });\n    60\t    } else if (result.exitCode === 2) {\n    61\t      logger.warn(\"job\", \"Pipeline encerrou com falha parcial.\", {\n    62\t        failedChunks: result.failedChunks,\n    63\t      });\n    64\t    } else {\n    65\t      logger.error(\"job\", result.errorSummary ?? \"Pipeline encerrou com erro fatal.\");\n    66\t    }\n    67\t\n    68\t    return result.exitCode;\n    69\t  } catch (error) {\n    70\t    const message = error instanceof Error ? error.message : String(error);\n    71\t    logger.error(\"cli\", message);\n    72\t    return 1;\n    73\t  }\n    74\t}\n    75\t\n    76\texport async function main(argv: string[] = process.argv.slice(2)): Promise<void> {\n    77\t  process.exitCode = await runCli(argv);\n    78\t}\n    79\t\n    80\tif (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {\n    81\t  await main();\n    82\t}\n","tool_use_id":"call_edNN8xwjcwhXUfLyR0DXMLVg"}
