e: unknown): Promise<void> {\n    43\t  await writeFile(path, `${JSON.stringify(value, null, 2)}\\n`, \"utf8\");\n    44\t}\n    45\t\n    46\tfunction cloneState(state: JobState): JobState {\n    47\t  return structuredClone(state) as JobState;\n    48\t}\n    49\t\n    50\texport class FileJobStore implements JobStore {\n    51\t  public readonly paths: JobPaths;\n    52\t  private mutationQueue: Promise<void> = Promise.resolve();\n    53\t\n    54\t  public constructor(paths: JobPaths) {\n    55\t    this.paths = paths;\n    56\t  }\n    57\t\n    58\t  public async hasPersistedJobArtifacts(): Promise<boolean> {\n    59\t    const [manifestExists, jobStateExists] = await Promise.all([\n    60\t      exists(this.paths.manifestPath),\n    61\t      exists(this.paths.jobStatePath),\n    62\t    ]);\n    63\t\n    64\t    return manifestExists || jobStateExists;\n    65\t  }\n    66\t\n    67\t  public async initializeJob(input: {\n    68\t    jobId: string;\n    69\t    provider: string;\n    70\t    cleanupPolicy: CleanupPolicy;\n    71\t    compatibility: JobCompatibilitySnapshot;\n    72\t  }): Promise<JobState> {\n    73\t    await mkdir(this.paths.rootDir, { recursive: true });\n    74\t    await mkdir(this.paths.chunksDir, { recursive: true });\n    75\t    await mkdir(this.paths.transcriptsDir, { recursive: true });\n    76\t\n    77\t    const state = createInitialJobState({\n    78\t      jobId: input.jobId,\n    79\t      provider: input.provider,\n    80\t      cleanupPolicy: input.cleanupPolicy,\n    81\t      compatibility: input.compatibility,\n    82\t    });\n    83\t\n    84\t    await writeJsonFile(this.paths.jobStatePath, state);\n    85\t    return state;\n    86\t  }\n    87\t\n    88\t  public async writeManifest(manifest: ChunkManifest): Promise<void> {\n    89\t    await writeJsonFile(this.paths.manifestPath, manifest);\n    90\t  }\n    91\t\n    92\t  public async readManifest(): Promise<ChunkManifest> {\n    93\t    return await readJsonFile<ChunkManifest>(this.paths.manifestPath);\n    94\t  }\n    95\t\n    96\t  public async hydrateChunksFromManifest(manifest: ChunkManifest): Promise<JobState> {\n    97\t    return await this.mutateState((state) => {\n    98\t      state.manifestPath = MANIFEST_FILE_NAME;\n    99\t      state.finalMarkdownPath = null;\n   100\t      state.chunks = createPendingChunks(manifest);\n   101\t      state.errorSummary = null;\n   102\t      return state;\n   103\t    });\n   104\t  }\n   105\t\n   106\t  public async readJobState(): Promise<JobState> {\n   107\t    await this.waitForMutations();\n   108\t    return await readJsonFile<JobState>(this.paths.jobStatePath);\n   109\t  }\n   110\t\n   111\t  public async tryReadJobState(): Promise<JobState | null> {\n   112\t    if (!(await exists(this.paths.jobStatePath))) {\n   113\t      return null;\n   114\t    }\n   115\t\n   116\t    return await this.readJobState();\n   117\t  }\n   118\t\n   119\t  public async updateJobStatus(nextStatus: JobStatus, metadata?: {\n   120\t    errorSummary?: string | null;\n   121\t    finalMarkdownPath?: string | null;\n   122\t  }): Promise<JobState> {\n   123\t    return await this.mutateState((state) => {\n   124\t      transitionJobStatus(state, nextStatus);\n   125\t\n   126\t      if (metadata?.errorSummary !== undefined) {\n   127\t        state.errorSummary = metadata.errorSummary;\n   128\t      } else if (nextStatus !== \"partial_failed\" && nextStatus !== \"fatal_error\") {\n   129\t        state.errorSummary = null;\n   130\t      }\n   131\t\n   132\t      if (metadata?.finalMarkdownPath !== undefined) {\n   133\t        state.finalMarkdownPath = metadata.finalMarkdownPath;\n   134\t      }\n   135\t\n   136\t      return state;\n   137\t    });\n   138\t  }\n   139\t\n   140\t  public async reconcileForResume(): Promise<JobState> {\n   141\t    return await this.mutateState((state) => {\n   142\t      for (const chunk of state.chunks) {\n   143\t        if (chunk.status === \"failed\") {\n   144\t          transitionChunkStatus(chunk, \"pending\");\n   145\t          chunk.startedAt = null;\n   146\t          chunk.finishedAt = null;\n   147\t        } else if (chunk.status === \"running\" && chunk.finishedAt === null) {\n   148\t          assertChunkStatusTransition(\"running\", \"pending\");\n   149\t          chunk.status = \"pending\";\n   150\t          chunk.startedAt = null;\n   151\t          chunk.finishedAt = null;\n   152\t        }\n   153\t      }\n   154\t\n   155\t      return state;\n   156\t    });\n   157\t  }\n   158\t\n   159\t  public async markChunkRunning(chunkIndex: number): Promise<JobState> {\n   160\t    return await this.mutateState((state) => {\n   161\t      const chunk = getChunkState(state, chunkIndex);\n   162\t      transitionChunkStatus(chunk, \"running\");\n   163\t      chunk.attempts += 1;\n   164\t      chunk.startedAt = new Date().toISOString();\n   165\t      chunk.finishedAt = null;\n   166\t      chunk.errorSummary = null;\n   167\t      return state;\n   168\t    });\n   169\t  }\n   170\t\n   171\t  public async markChunkSucceeded(chunkIndex: number, markdownPath: string): Promise<JobState> {\n   172\t    return await this.mutateState((state) => {\n   173\t      const chunk = getChunkState(state, chunkIndex);\n   174\t      transitionChunkStatus(chunk, \"succeeded\");\n   175\t      chunk.finishedAt = new Date().toISOString();\n   176\t      chunk.markdownPath = markdownPath;\n   177\t      chunk.errorSummary = null;\n   178\t      return state;\n   179\t    });\n   180\t  }\n   181\t\n   182\t  public async markChunkFailed(chunkIndex: number, errorSummary: string): Promise<JobState> {\n   183\t    return await this.mutateState((state) => {\n   184\t      const chunk = getChunkState(state, chunkIndex);\n   185\t      transitionChunkStatus(chunk, \"failed\");\n   186\t      chunk.finishedAt = new Date().toISOString();\n   187\t      chunk.errorSummary = errorSummary;\n   188\t      return state;\n   189\t    });\n   190\t  }\n   191\t\n   192\t  public async writeChunkMarkdown(chunkIndex: number, markdown: string): Promise<string> {\n   193\t    const outputPath = resolveFromRoot(this.paths.rootDir, `transcripts/${formatChunkMarkdownFileName(chunkIndex)}`);\n   194\t    await writeFile(outputPath, markdown, \"utf8\");\n   195\t    return normalizeRelativePath(this.paths.rootDir, outputPath);\n   196\t  }\n   197\t\n   198\t  public async writeFinalMarkdown(markdown: string): Promise<string> {\n   199\t    await writeFile(this.paths.finalTranscriptPath, markdown, \"utf8\");\n   200\t    return FINAL_TRANSCRIPT_FILE_NAME;\n   201\t  }\n   202\t\n   203\t  public async readMarkdown(relativePath: string): Promise<string> {\n   204\t    return await readFile(resolveFromRoot(this.paths.rootDir, relativePath), \"utf8\");\n   205\t  }\n   206\t\n   207\t  public async cleanupChunkArtifacts(manifest: ChunkManifest): Promise<void> {\n   208\t    await Promise.all(\n   209\t      manifest.chunks.map(async (chunk) => {\n   210\t        await rm(resolveFromRoot(this.paths.rootDir, chunk.chunkPath), { force: true });\n   211\t      }),\n   212\t    );\n   213\t  }\n   214\t\n   215\t  private async waitForMutations(): Promise<void> {\n   216\t    await this.mutationQueue.catch(() => undefined);\n   217\t  }\n   218\t\n   219\t  private async mutateState(mutator: (state: JobState) => JobState | Promise<JobState>): Promise<JobState> {\n   220\t    let nextState: JobState | undefined;\n   221\t\n   222\t    const previousQueue = this.mutationQueue.catch(() => undefined);\n   223\t\n   224\t    this.mutationQueue = previousQueue.then(async () => {\n   225\t      const currentState = await readJsonFile<JobState>(this.paths.jobStatePath);\n   226\t      const mutableState = cloneState(currentState);\n   227\t      nextState = await mutator(mutableState);\n   228\t      nextState.updatedAt = new Date().toISOString();\n   229\t      await writeJsonFile(this.paths.jobStatePath, nextState);\n   230\t    });\n   231\t\n   232\t    await this.mutationQueue;\n   233\t\n   234\t    if (nextState === undefined) {\n   235\t      throw new Error(\"Falha ao persistir job-state.json\");\n   236\t    }\n   237\t\n   238\t    return nextState;\n   239\t  }\n   240\t}\n","tool_use_id":"call_Qflh137LhvVCxS6PphuIj8ES"}
