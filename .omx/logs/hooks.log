  84\t    chunkDurationMs: input.chunkDurationMs,\n    85\t    segmenter: input.mediaSegmenter.name,\n    86\t  });\n    87\t  const segmentation = await input.mediaSegmenter.segment({\n    88\t    inputPath: compatibility.resolvedInputPath,\n    89\t    jobRootDir: input.jobStore.paths.rootDir,\n    90\t    workingDir: input.jobStore.paths.chunksDir,\n    91\t    chunkDurationMs: input.chunkDurationMs,\n    92\t  });\n    93\t\n    94\t  await input.jobStore.writeManifest(segmentation.manifest);\n    95\t  await input.jobStore.hydrateChunksFromManifest(segmentation.manifest);\n    96\t  await input.jobStore.updateJobStatus(\"ready\");\n    97\t}\n    98\t\n    99\tasync function prepareResume(input: RunTranscriptionJobInput, compatibility: JobCompatibilitySnapshot): Promise<JobState> {\n   100\t  const existingState = await input.jobStore.readJobState();\n   101\t  await input.jobStore.readManifest();\n   102\t\n   103\t  assertCompatibleSnapshot(existingState.compatibility, compatibility);\n   104\t\n   105\t  if (existingState.status === \"created\" || existingState.status === \"segmenting\" || existingState.status === \"fatal_error\") {\n   106\t    throw new Error(`Job em estado ${existingState.status} nao pode ser retomado.`);\n   107\t  }\n   108\t\n   109\t  if (existingState.status === \"succeeded\") {\n   110\t    return existingState;\n   111\t  }\n   112\t\n   113\t  return await input.jobStore.reconcileForResume();\n   114\t}\n   115\t\n   116\tfunction collectPendingChunks(state: JobState, manifestChunks: ChunkManifestEntry[]): ChunkManifestEntry[] {\n   117\t  const pendingIndexes = new Set(\n   118\t    state.chunks\n   119\t      .filter((chunk) => chunk.status === \"pending\")\n   120\t      .map((chunk) => chunk.index),\n   121\t  );\n   122\t\n   123\t  return manifestChunks.filter((chunk) => pendingIndexes.has(chunk.index));\n   124\t}\n   125\t\n   126\tasync function transcribeChunk(input: RunTranscriptionJobInput, chunk: ChunkManifestEntry): Promise<void> {\n   127\t  input.logger.info(\"transcribe\", \"Processando chunk.\", {\n   128\t    chunk: formatChunkIndex(chunk.index),\n   129\t  });\n   130\t  await input.jobStore.markChunkRunning(chunk.index);\n   131\t\n   132\t  try {\n   133\t    const transcription = await input.transcriber.transcribe({\n   134\t      chunkIndex: chunk.index,\n   135\t      audioPath: resolve(input.jobStore.paths.rootDir, chunk.chunkPath),\n   136\t      startMs: chunk.startMs,\n   137\t      endMs: chunk.endMs,\n   138\t      jobMetadata: {\n   139\t        provider: input.provider,\n   140\t        sourceFile: basename(input.inputPath),\n   141\t      },\n   142\t    });\n   143\t    const markdownPath = await input.jobStore.writeChunkMarkdown(\n   144\t      chunk.index,\n   145\t      renderChunkMarkdown(chunk, transcription.markdown),\n   146\t    );\n   147\t    await input.jobStore.markChunkSucceeded(chunk.index, markdownPath);\n   148\t  } catch (error) {\n   149\t    const errorSummary = summarizeError(error);\n   150\t    await input.jobStore.markChunkFailed(chunk.index, errorSummary);\n   151\t    input.logger.error(\"transcribe\", `Chunk ${formatChunkIndex(chunk.index)} falhou.`, {\n   152\t      errorSummary,\n   153\t    });\n   154\t  }\n   155\t}\n   156\t\n   157\tasync function ensureRunningState(input: RunTranscriptionJobInput, state: JobState): Promise<JobState> {\n   158\t  if (state.status === \"ready\" || state.status === \"partial_failed\") {\n   159\t    return await input.jobStore.updateJobStatus(\"running\");\n   160\t  }\n   161\t\n   162\t  return state;\n   163\t}\n   164\t\n   165\tfunction buildResultFromState(state: JobState): RunTranscriptionJobResult {\n   166\t  return {\n   167\t    exitCode: computeExitCode(state),\n   168\t    jobStatus: state.status,\n   169\t    failedChunks: getFailedChunks(state).map((chunk) => chunk.index),\n   170\t    finalMarkdownPath: state.finalMarkdownPath,\n   171\t    errorSummary: state.errorSummary,\n   172\t  };\n   173\t}\n   174\t\n   175\tasync function markFatalIfPossible(jobStore: JobStore, errorSummary: string): Promise<void> {\n   176\t  const currentState = await jobStore.tryReadJobState();\n   177\t\n   178\t  if (currentState === null) {\n   179\t    return;\n   180\t  }\n   181\t\n   182\t  if (currentState.status === \"succeeded\" || currentState.status === \"fatal_error\") {\n   183\t    return;\n   184\t  }\n   185\t\n   186\t  if (currentState.status === \"partial_failed\") {\n   187\t    return;\n   188\t  }\n   189\t\n   190\t  await jobStore.updateJobStatus(\"fatal_error\", { errorSummary });\n   191\t}\n   192\t\n   193\texport async function runTranscriptionJob(input: RunTranscriptionJobInput): Promise<RunTranscriptionJobResult> {\n   194\t  let stateIsMutable = false;\n   195\t\n   196\t  try {\n   197\t    const compatibility = await createCompatibilitySnapshot({\n   198\t      inputPath: input.inputPath,\n   199\t      provider: input.provider,\n   200\t      chunkDurationSeconds: input.chunkDurationSeconds,\n   201\t    });\n   202\t    const artifactsExist = await input.jobStore.hasPersistedJobArtifacts();\n   203\t\n   204\t    if (artifactsExist) {\n   205\t      if (!input.resume) {\n   206\t        throw new Error(\"outputDir ja contem artefatos de job. Use --resume para reaproveitar o estado persistido.\");\n   207\t      }\n   208\t\n   209\t      await prepareResume(input, compatibility);\n   210\t      stateIsMutable = true;\n   211\t    } else {\n   212\t      if (input.resume) {\n   213\t        throw new Error(\"Nao existe job persistido para retomar com --resume.\");\n   214\t      }\n   215\t\n   216\t      await input.jobStore.initializeJob({\n   217\t        jobId: randomUUID(),\n   218\t        provider: input.provider,\n   219\t        cleanupPolicy: input.cleanupPolicy,\n   220\t        compatibility,\n   221\t      });\n   222\t      stateIsMutable = true;\n   223\t      await finishBootstrappingNewJob(input, compatibility);\n   224\t    }\n   225\t\n   226\t    let currentState = await input.jobStore.readJobState();\n   227\t\n   228\t    if (currentState.status === \"succeeded\") {\n   229\t      return buildResultFromState(currentState);\n   230\t    }\n   231\t\n   232\t    currentState = await ensureRunningState(input, currentState);\n   233\t\n   234\t    const manifest = await input.jobStore.readManifest();\n   235\t    const pendingChunks = collectPendingChunks(currentState, manifest.chunks);\n   236\t\n   237\t    await runTaskPool({\n   238\t      items: pendingChunks,\n   239\t      concurrency: input.concurrency,\n   240\t      worker: async (chunk) => {\n   241\t        await transcribeChunk(input, chunk);\n   242\t      },\n   243\t    });\n   244\t\n   245\t    currentState = await input.jobStore.readJobState();\n   246\t\n   247\t    if (getFailedChunks(currentState).length > 0) {\n   248\t      currentState = await input.jobStore.updateJobStatus(\"partial_failed\", {\n   249\t        errorSummary: \"Uma ou mais transcricoes falharam; o job pode ser retomado com --resume.\",\n   250\t      });\n   251\t\n   252\t      return buildResultFromState(currentState);\n   253\t    }\n   254\t\n   255\t    if (!allChunksSucceeded(currentState)) {\n   256\t      throw new Error(\"Estado inconsistente: ha chunks sem sucesso mesmo sem falhas registradas.\");\n   257\t    }\n   258\t\n   259\t    const merged = await mergeTranscripts({\n   260\t      jobStore: input.jobStore,\n","tool_use_id":"call_S5QY1vFx3oWK3Gw65Tv2XKGo"}
